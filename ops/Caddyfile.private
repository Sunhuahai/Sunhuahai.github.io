{
 admin off
 auto_https off
}
http://127.0.0.1:18080 {
 bind 127.0.0.1
 root * /srv/huahaiatlas/current
 encode zstd gzip
 header {
  X-Robots-Tag "noindex, nofollow"
  X-Content-Type-Options nosniff
  Referrer-Policy strict-origin-when-cross-origin
 }
 @assets path /_s/* /assets/*
 header @assets Cache-Control "public, max-age=3600"
 file_server
 log {
  output file /srv/huahaiatlas/logs/access.log {
   roll_size 5MiB
   roll_keep 3
  }
 }
}
http://127.0.0.1:18081 {
 bind 127.0.0.1
 header X-Robots-Tag "noindex, nofollow"
 @root path /
 redir @root /status/atlas 302
 @safe {
  method GET HEAD
  path /status/atlas /status/atlas/ /api/status-page/atlas /api/status-page/heartbeat/atlas /assets/* /icon.svg /manifest.json
 }
 handle @safe {
  reverse_proxy 127.0.0.1:3001
 }
 handle {
  respond "Not found" 404
 }
}
