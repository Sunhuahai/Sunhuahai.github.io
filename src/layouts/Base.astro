---
import '../styles/global.css';
import { site } from '../config/site';
import SocialLinks from '../components/SocialLinks.astro';
import { canonicalUrl, serializeJsonLd, shareImage } from '../utils/seo';

interface Props {
  title?: string;
  description?: string;
  /** Use `title` as the document title with no wordmark suffix. */
  exactTitle?: boolean;
  lang?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  jsonLd?: unknown;
  robots?: string;
}

const {
  title = site.title,
  description = site.description,
  exactTitle = false,
  lang = 'zh-CN',
  ogType = 'website',
  publishedTime,
  jsonLd,
  robots,
} = Astro.props;

const pageTitle = exactTitle || title === site.title ? title : `${title} · ${site.title}`;
const canonical = canonicalUrl(Astro.url.pathname);
const image = new URL(shareImage.path, site.url).href;
const jsonLdHtml = jsonLd === undefined ? '' : serializeJsonLd(jsonLd);
let articleDay = '';
if (ogType === 'article') {
  if (!publishedTime || !/^\d{4}-\d{2}-\d{2}$/.test(publishedTime)) {
    throw new Error(`Article page ${canonical} requires publishedTime YYYY-MM-DD`);
  }
  articleDay = publishedTime;
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#000000" />
    <meta name="theme-color" content="#000000" />
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content={shareImage.type} />
    <meta property="og:image:width" content={String(shareImage.width)} />
    <meta property="og:image:height" content={String(shareImage.height)} />
    <meta property="og:image:alt" content={shareImage.alt} />
    {
      ogType === 'article' && (
        <>
          <meta property="article:published_time" content={articleDay} />
          <meta property="article:author" content={site.orcid} />
        </>
      )
    }
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={shareImage.alt} />
    {
      site.blogEnabled && (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={`${site.title} · ${site.labels.blog}`}
          href={canonicalUrl('/rss.xml')}
        />
      )
    }
    {jsonLdHtml && <script type="application/ld+json" is:inline set:html={jsonLdHtml} />}
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        const t = localStorage.getItem('atlas-theme');
        document.documentElement.dataset.theme =
          t || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch {}
    </script>
  </head>
<body><a class="skip" href="#main">{site.labels.skip}</a><header class="header"><div class="header-inner"><a class="wordmark" href="/"><img src="/favicon.svg" width="30" height="30" alt=""/><span>{site.title}</span></a><button class="menu-toggle" aria-label={site.labels.menu} aria-expanded="false" aria-controls="navigation">☰</button><nav id="navigation" aria-label={site.labels.menu}>{site.nav.filter(n=>site.blogEnabled || n.href!=='/blog/').map(n=><a href={n.href} aria-current={(n.href==='/'?Astro.url.pathname==='/':Astro.url.pathname.startsWith(n.href))?'page':undefined}>{n.label}</a>)}</nav><button class="theme-toggle" aria-label={site.labels.theme} title={site.labels.theme}>◐</button></div></header><main id="main"><slot/></main><footer><div><a href="/">{site.title}</a><p>{site.labels.footer}</p><SocialLinks compact /></div><p>© {new Date().getFullYear()} {site.englishName}<br/><a href="https://github.com/dadangnh/as-folio" rel="noreferrer">as-folio</a> · Astro</p></footer>
<script>
const toggle=document.querySelector<HTMLButtonElement>('.theme-toggle');
toggle?.addEventListener('click',()=>{const next=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=next;try{localStorage.setItem('atlas-theme',next)}catch{}});
const menu=document.querySelector<HTMLButtonElement>('.menu-toggle');menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));document.querySelector('nav')?.classList.toggle('open',open)});
</script></body></html>
