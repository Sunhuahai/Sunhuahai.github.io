---
import '../styles/global.css';
import {site} from '../config/site';
interface Props {title?:string;description?:string;lang?:string}
const {title=site.title,description=site.description,lang='zh-CN'}=Astro.props;
const canonical=new URL(Astro.url.pathname,site.url).href;
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title===site.title?title:`${title} · ${site.title}`}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png"/><link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png"/><link rel="icon" href="/favicon.ico" sizes="any"/><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/><link rel="manifest" href="/site.webmanifest"/><link rel="mask-icon" href="/safari-pinned-tab.svg" color="#000000"/><meta name="theme-color" content="#000000"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content={`${site.url}/assets/avatar-illustrated.webp`}/><meta name="twitter:card" content="summary"/><meta name="color-scheme" content="light dark"/><script is:inline>try{const t=localStorage.getItem('atlas-theme');document.documentElement.dataset.theme=t||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}catch{}</script></head>
<body><a class="skip" href="#main">{site.labels.skip}</a><header class="header"><div class="header-inner"><a class="wordmark" href="/"><img src="/favicon.svg" width="30" height="30" alt=""/><span>{site.title}</span></a><button class="menu-toggle" aria-label={site.labels.menu} aria-expanded="false" aria-controls="navigation">☰</button><nav id="navigation" aria-label={site.labels.menu}>{site.nav.filter(n=>site.blogEnabled || n.href!=='/blog/').map(n=><a href={n.href} aria-current={(n.href==='/'?Astro.url.pathname==='/':Astro.url.pathname.startsWith(n.href))?'page':undefined}>{n.label}</a>)}</nav><button class="theme-toggle" aria-label={site.labels.theme} title={site.labels.theme}>◐</button></div></header><main id="main"><slot/></main><footer><div><a href="/">{site.title}</a><p>{site.labels.footer}</p></div><p>© {new Date().getFullYear()} {site.englishName}<br/><a href="https://github.com/dadangnh/as-folio" rel="noreferrer">as-folio</a> · Astro</p></footer>
<script>
const toggle=document.querySelector<HTMLButtonElement>('.theme-toggle');
toggle?.addEventListener('click',()=>{const next=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=next;try{localStorage.setItem('atlas-theme',next)}catch{}});
const menu=document.querySelector<HTMLButtonElement>('.menu-toggle');menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));document.querySelector('nav')?.classList.toggle('open',open)});
</script></body></html>
