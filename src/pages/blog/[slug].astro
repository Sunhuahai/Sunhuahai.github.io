---
import Base from '../../layouts/Base.astro';import {getCollection,render} from 'astro:content';import {site} from '../../config/site';import 'katex/dist/katex.min.css';
export async function getStaticPaths(){return (await getCollection('posts',p=>!p.data.draft)).map(entry=>({params:{slug:entry.id},props:{entry}}));}
const {entry}=Astro.props;const {Content,headings}=await render(entry);
---
<Base title={entry.data.title} description={entry.data.description}><section class="page-top"><a href="/blog/">← {site.labels.back}</a><p class="eyebrow">{entry.data.date.toISOString().slice(0,10)} · {entry.data.tags.join(' / ')}</p><h1>{entry.data.title}</h1><p>{entry.data.description}</p></section>{entry.data.toc&&headings.length>0&&<nav class="toc" aria-label={site.labels.contents}>{headings.filter(h=>h.depth<=3).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav>}<article class="prose"><Content/></article></Base>
