---
import Base from '../../layouts/Base.astro';import {getCollection} from 'astro:content';import {site} from '../../config/site';
const projects=(await getCollection('projects',p=>p.data.public)).sort((a,b)=>b.data.year-a.data.year);
---
<Base title={site.labels.projects} description={site.pages.projects}><section class="page-top"><p class="eyebrow">Research projects</p><h1>{site.labels.projects}</h1><p>成像物理、统计建模与机器学习。</p></section><div class="project-grid">{projects.map((p,i)=><article class="project-card"><a href={`/projects/${p.id}/`}><div class={`project-art art-${i}`}><img src="/hero-scientific.svg" width="800" height="500" alt="抽象科学几何品牌图形"/><span>0{i+1} / {p.data.year}</span></div><div class="project-copy"><p class="eyebrow">{p.data.category} · {p.data.year}</p><h2>{p.data.title} ↗</h2></div></a></article>)}</div></Base>
