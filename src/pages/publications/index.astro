---
import Base from '../../layouts/Base.astro';import Paper from '../../components/Paper.astro';import {papers} from '../../utils/publications';import {site} from '../../config/site';
const years=[...new Set(papers.map(p=>p.year))];
---
<Base title={site.labels.papers}><section class="page-top"><p class="eyebrow">Publications</p><h1>{site.labels.papers}</h1><p>期刊论文 · 完整作者与正式出版记录</p></section><div class="filter"><label for="year">{site.labels.year}</label><select id="year"><option value="all">{site.labels.all}</option>{years.map(y=><option value={y}>{y}</option>)}</select><a href="/publications.bib" download>{site.labels.bib} ↓</a></div><section>{papers.map((paper,index)=><Paper {paper} {index}/>)}</section><p class="muted note">{papers.length} 篇正式发表期刊论文</p></Base>
<script>document.querySelector<HTMLSelectElement>('#year')?.addEventListener('change',e=>{const year=(e.target as HTMLSelectElement).value;document.querySelectorAll<HTMLElement>('[data-year]').forEach(p=>p.hidden=year!=='all'&&p.dataset.year!==year)});</script>
