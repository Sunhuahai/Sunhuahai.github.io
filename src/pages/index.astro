---
import Base from '../layouts/Base.astro';import Paper from '../components/Paper.astro';import {site} from '../config/site';import {papers} from '../utils/publications';import {getCollection} from 'astro:content';
const latestPosts=(await getCollection('posts',p=>!p.data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
---
<Base><section class="hero"><div class="hero-copy"><p class="eyebrow">{site.subtitle}</p><h1>从物理出发，<br/>理解与重建<span>世界。</span></h1><div class="identity"><span>{site.name}</span><span>{site.englishName}</span></div><p class="role">{site.role}</p><p class="intro">{site.bio}</p><div class="actions"><a class="button" href="/publications/">{site.labels.papers} <span>↗</span></a><a class="text-link" href="/about/">关于我 →</a></div></div><div class="portrait-scene"><img class="scientific-art" src="/hero-scientific.svg" alt=""/><div class="portrait-frame"><img src="/assets/avatar-illustrated.webp" width="640" height="640" alt="孙华海的个人肖像" fetchpriority="high"/></div><div class="portrait-caption"><span>孙华海 / HUAHAI SUN</span><small>COMPUTATIONAL IMAGING</small></div><span class="orbit-label">物理 · 数学 · 计算</span></div></section>
<section class="research-strip"><p class="eyebrow">Research interests</p><div>{site.interests.map((s,i)=><span><small>0{i+1}</small>{s}</span>)}</div></section>
<section class="section"><div class="section-heading"><div><p class="eyebrow">Selected publications</p><h2>{site.labels.papers}</h2></div><a class="text-link" href="/publications/">{site.labels.allPapers} ↗</a></div>{papers.slice(0,2).map((paper,index)=><Paper {paper} {index}/>)}</section>
<section class="closing-grid"><a class="feature-link" href="/projects/"><p class="eyebrow">Published research</p><h2>{site.labels.projects} ↗</h2><p>从成像测量到统计建模，探索已发表工作中的问题与方法。</p></a><div class="feature-link"><p class="eyebrow">Notes & essays</p><h2><a href="/blog/">{site.labels.blog} ↗</a></h2>{latestPosts.length>0?<ul class="home-posts">{latestPosts.map(p=><li><a href={`/blog/${p.id}/`}>{p.data.title}<span>↗</span></a></li>)}</ul>:<p>{site.labels.emptyBlogBody}</p>}</div></section></Base>
